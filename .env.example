# 默认完全离线，不调用模型、不写入 GitHub。
IA_MODEL_MODE=fixture
IA_TOOL_MODE=fixture
IA_REPOSITORY=Shahuang123269/-1
IA_DATA_DIR=data
# 真实模型：IA_MODEL_MODE=deepseek，密钥只写到本地 .env。
IA_DEEPSEEK_API_KEY=
IA_DEEPSEEK_MODEL=deepseek-flash
IA_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 真实 GitHub：IA_TOOL_MODE=github。读取公有仓库可不配置 token。
IA_GITHUB_TOKEN=
# 真实写入需要此开关 + 仓库限定 + 人工批准具体 action digest。
IA_ALLOW_REMOTE_WRITES=false
# 服务默认仅绑定 127.0.0.1。对外部署前必须设置 API token 并配置 HTTPS。
IA_API_TOKEN=
IA_MAX_MODEL_CALLS=6
IA_MAX_TOOL_CALLS=10
IA_MAX_CONTEXT_CHARS=40000
IA_TIMEOUT_SECONDS=30

# 可选独立只读 GitHub token；为空时回退到 IA_GITHUB_TOKEN（不构成凭据隔离）。
IA_GITHUB_READ_TOKEN=
# Webhook 未配置密钥时关闭；同时必须启用 github 工具模式。
IA_WEBHOOK_SECRET=
# 默认规则内置；使用自定义规则时设为文件路径，例如 policy.example.toml。
# IA_POLICY_PATH=policy.example.toml
# 本地默认内嵌单执行器；独立 worker 部署时 API 设置 false。
IA_EMBEDDED_WORKER=true
IA_QUEUE_LIMIT=64
IA_WORKER_POLL_SECONDS=0.2

# 模型连接失败且本机系统代理不可用时，可仅对模型客户端设 false；不修改系统代理。
IA_HTTP_TRUST_ENV=true
